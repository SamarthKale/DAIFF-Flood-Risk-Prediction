# Your own Google Earth Engine Cloud project ID (see docs/setup/gee.md)
DAIFF_GEE_PROJECT=
# Optional: base folder for data (default: ./data next to configs/)
DAIFF_DATA_ROOT=
# Optional (Tier 2 e-mail alerts): SMTP server host
SMTP_HOST=
# SMTP port (587 for STARTTLS)
SMTP_PORT=
# SMTP user name
SMTP_USER=
# SMTP password or app password
SMTP_PASSWORD=
# Recipient address for alerts
ALERT_EMAIL_TO=
